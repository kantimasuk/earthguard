# ===== Server =====
PORT=3000
# URL ของหน้าเว็บที่อนุญาตให้เรียก API (CORS) คั่นหลายค่าด้วย ,
CLIENT_ORIGIN=http://localhost:5173

# ===== MySQL (Railway) =====
# คัดลอก MYSQL_PUBLIC_URL จากแท็บ Variables ของ MySQL บน Railway (ตอน deploy บน Railway ใช้ MYSQL_URL ได้เลย)
DATABASE_URL=mysql://root:password@host:port/railway

# ===== Firebase Admin =====
# Firebase Console → Project settings → Service accounts → Generate new private key
# วาง JSON ทั้งไฟล์เป็นบรรทัดเดียว หรือแปลงเป็น base64 ก็ได้
FIREBASE_SERVICE_ACCOUNT=

# อีเมลลืมรหัสผ่าน: Firebase Authentication ส่งให้เอง ไม่ต้องตั้งค่า SMTP
