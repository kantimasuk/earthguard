# ===== Server =====
PORT=3000
# URL ของหน้าเว็บ (ใช้สร้างลิงก์รีเซ็ตรหัสผ่าน + CORS) คั่นหลายค่าด้วย ,  ค่าแรกใช้สร้างลิงก์
CLIENT_ORIGIN=http://localhost:5173

# ===== MySQL (Railway) =====
# คัดลอก MYSQL_PUBLIC_URL จากแท็บ Variables ของ MySQL บน Railway (ตอน deploy บน Railway ใช้ MYSQL_URL ได้เลย)
DATABASE_URL=mysql://root:password@host:port/railway

# ===== Firebase Admin =====
# Firebase Console → Project settings → Service accounts → Generate new private key
# วาง JSON ทั้งไฟล์เป็นบรรทัดเดียว หรือแปลงเป็น base64 ก็ได้
FIREBASE_SERVICE_ACCOUNT=

# ===== อีเมลสำหรับส่งลิงก์รีเซ็ตรหัสผ่าน (SMTP) =====
# ถ้าเว้นว่าง ระบบจะพิมพ์ลิงก์ไว้ใน console แทน (สะดวกตอนพัฒนา)
# Gmail: เปิด 2-Step Verification แล้วสร้าง App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EarthGuard <no-reply@example.com>"
